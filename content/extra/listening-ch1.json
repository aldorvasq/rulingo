      "listening": [
        {
          "id": "1.1-l-1",
          "title": "En el avión",
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Стюарде́сса",
              "gender": "f",
              "ru": "Приве́т! Ко́фе и́ли чай?"
            },
            {
              "speaker": "Жан",
              "gender": "m",
              "ru": "Вино́, пожа́луйста."
            },
            {
              "speaker": "Стюарде́сса",
              "gender": "f",
              "ru": "Вот, пожа́луйста. А вам?"
            },
            {
              "speaker": "Джова́нни",
              "gender": "m",
              "ru": "Ко́фе, пожа́луйста. И сок."
            },
            {
              "speaker": "Стюарде́сса",
              "gender": "f",
              "ru": "Вот ко́фе и сок."
            },
            {
              "speaker": "Джова́нни",
              "gender": "m",
              "ru": "Спаси́бо! Меня́ зову́т Джова́нни. А тебя́?"
            },
            {
              "speaker": "Жан",
              "gender": "m",
              "ru": "Меня́ зову́т Жан. О́чень прия́тно!"
            },
            {
              "speaker": "Джова́нни",
              "gender": "m",
              "ru": "О́чень прия́тно! Как дела́?"
            },
            {
              "speaker": "Жан",
              "gender": "m",
              "ru": "Отли́чно! А у тебя́?"
            },
            {
              "speaker": "Джова́нни",
              "gender": "m",
              "ru": "То́же хорошо́, спаси́бо."
            }
          ],
          "es": "¡Hola! ¿Café o té?\nVino, por favor.\nAquí tiene. ¿Y para usted?\nCafé, por favor. Y un jugo.\nAquí está el café y el jugo.\n¡Gracias! Me llamo Giovanni. ¿Y tú?\nMe llamo Jean. ¡Mucho gusto!\n¡Mucho gusto! ¿Qué tal?\n¡Excelente! ¿Y tú?\nTambién bien, gracias.",
          "questions": [
            {
              "q": "¿Qué pide Jean?",
              "choices": [
                "Café",
                "Vino",
                "Té"
              ],
              "answer": 1
            },
            {
              "q": "¿Qué pide Giovanni además del café?",
              "choices": [
                "Jugo",
                "Cerveza",
                "Agua"
              ],
              "answer": 0
            },
            {
              "q": "¿Cómo está Jean?",
              "choices": [
                "Mal",
                "Más o menos",
                "Excelente"
              ],
              "answer": 2
            }
          ]
        },
        {
          "id": "1.1-l-2",
          "title": "Klaus en Moscú",
          "kind": "story",
          "lines": [
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Приве́т! Меня́ зову́т Кла́ус."
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Вот ка́рта. Э́то Москва́, а не Пари́ж."
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Что э́то? Э́то метро́. А э́то стадио́н и цирк."
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Кто э́то? Э́то ма́ма? Нет, э́то не ма́ма. Э́то шеф."
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Вот рестора́н. Суп, торт и чай, пожа́луйста."
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Спаси́бо! Э́то о́чень хорошо́!"
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Пока́! До встре́чи!"
            }
          ],
          "es": "¡Hola! Me llamo Klaus.\nAquí está el mapa. Es Moscú, no París.\n¿Qué es esto? Es el metro. Y esto es un estadio y un circo.\n¿Quién es? ¿Es una mamá? No, no es una mamá. Es un chef.\nAquí está el restaurante. Sopa, pastel y té, por favor.\n¡Gracias! ¡Está muy bien!\n¡Adiós! ¡Nos vemos!",
          "questions": [
            {
              "q": "¿Qué ciudad muestra el mapa?",
              "choices": [
                "París",
                "Moscú",
                "Nueva York"
              ],
              "answer": 1
            },
            {
              "q": "¿Quién es la persona que ve Klaus?",
              "choices": [
                "Una mamá",
                "Un actor",
                "Un chef"
              ],
              "answer": 2
            },
            {
              "q": "¿Qué pide Klaus en el restaurante?",
              "choices": [
                "Sopa, pastel y té",
                "Sopa y cerveza",
                "Pastel y vino"
              ],
              "answer": 0
            }
          ]
        }
      ]
