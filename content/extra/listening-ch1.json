            {
              "speaker": "А́на",
              "gender": "f",
              "ru": "Я хорошо́ говорю́ по-испа́нски и по-англи́йски."
            },
            {
              "speaker": "А́на",
              "gender": "f",
              "ru": "По-ру́сски я говорю́ немно́го."
