        {
          "id": "1.2-l-1",
          "title": "Control de pasaportes",
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Офице́р",
              "gender": "f",
              "ru": "До́брый день! Па́спорт, пожа́луйста."
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Здра́вствуйте! Вот, пожа́луйста."
            },
            {
              "speaker": "Офице́р",
              "gender": "f",
              "ru": "Как Вас зову́т? Отку́да Вы?"
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Меня́ зову́т Кла́ус Фи́шер. Я из Герма́нии. Я не́мец."
            },
            {
              "speaker": "Офице́р",
              "gender": "f",
              "ru": "Вы говори́те по-ру́сски?"
            },
            {
              "speaker": "Кла́ус",
              "gender": "m",
              "ru": "Да, немно́го."
            },
            {
              "speaker": "Офице́р",
              "gender": "f",
              "ru": "Хорошо́. А Вы? Отку́да Вы?"
            },
            {
              "speaker": "Ван Ли",
              "gender": "m",
              "ru": "Я Ван Ли. Я из Кита́я. По-ру́сски я говорю́ чуть-чуть."
            },
            {
              "speaker": "Офице́р",
              "gender": "f",
              "ru": "Спаси́бо. До свида́ния!"
            },
            {
              "speaker": "Ван Ли",
              "gender": "m",
              "ru": "До свида́ния!"
            }
          ],
          "es": "¡Buenas tardes! Pasaporte, por favor.\n¡Buenas tardes! Aquí tiene.\n¿Cómo se llama? ¿De dónde es usted?\nMe llamo Klaus Fischer. Soy de Alemania. Soy alemán.\n¿Habla usted ruso?\nSí, un poco.\nBien. ¿Y usted? ¿De dónde es?\nSoy Van Li. Soy de China. Hablo ruso un poquito.\nGracias. ¡Hasta luego!\n¡Hasta luego!",
          "questions": [
            {
              "q": "¿De dónde es Klaus?",
              "choices": [
                "Suiza",
                "Alemania",
                "Francia"
              ],
              "answer": 1
            },
            {
              "q": "¿Qué tan bien habla ruso Klaus?",
              "choices": [
                "Un poco",
                "Muy bien",
                "Nada"
              ],
              "answer": 0
            },
            {
              "q": "¿De dónde es Van Li?",
              "choices": [
                "Italia",
                "Canadá",
                "China"
              ],
              "answer": 2
            }
          ]
        },
        {
