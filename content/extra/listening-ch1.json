          "title": "La conferencia de negocios",
          "kind": "story",
          "lines": [
            {
              "speaker": "Серге́й",
              "gender": "m",
              "ru": "До́брый день! Меня́ зову́т Серге́й Ивано́в."
            },
            {
              "speaker": "Серге́й",
